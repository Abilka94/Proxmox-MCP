+async def task_cancel(
+    client: PveClient,
+    upid: str,
+    *,
+    node: str,
+    wait: bool = False,
+    timeout: int = 120,
+    poll_interval: float = 1.0,
+) -> dict[str, object]:
+    path = (
+        f"/nodes/{httpx.URL(node).path}/tasks/"
+        f"{urllib.parse.quote(upid, safe='')}/status/stop"
+    )
+
+    try:
+        current = await client.get_task_status(upid, node=node)
+    except PveApiError:
+        current_status = None
+    else:
+        current_status = current.status
+
+    if current_status == "stopped":
+        return {
+            "upid": upid,
+            "node": node,
+            "cancel_requested": False,
+            "stopped": False,
+            "message": "Задача уже завершена",
+        }
+
+    await client._post_json(path)
+
+    if not wait:
+        return {
+            "upid": upid,
+            "node": node,
+            "status": "running",
+            "cancel_requested": True,
+            "stopped": False,
+            "message": "Запрос на остановку задачи отправлен",
+        }
+
+    wait_result = await task_wait(
+        client,
+        upid,
+        node=node,
+        timeout=timeout,
+        poll_interval=poll_interval,
+    )
+
+    if wait_result.get("timed_out"):
+        return {
+            "upid": upid,
+            "node": node,
+            "status": wait_result.get("status", "running"),
+            "cancel_requested": True,
+            "stopped": False,
+            "message": f"Задача не остановилась за {timeout} сек",
+        }
+
+    result: dict[str, object] = {
+        "upid": upid,
+        "node": node,
+        "status": "stopped",
+        "cancel_requested": True,
+        "stopped": True,
+        "message": "Задача остановлена",
+    }
+    exitstatus = wait_result.get("exitstatus")
+    if exitstatus is not None:
+        result["exitstatus"] = exitstatus
+    wait_seconds = wait_result.get("wait_seconds")
+    if wait_seconds is not None:
+        result["wait_seconds"] = wait_seconds
+    return result
